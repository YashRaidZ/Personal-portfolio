# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://jjxyketdavadomrjkczy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_yafMi0hqyJD5cw0cAtRBSw_4HygH7vj
# Only used locally by `npm run db:types` (supabase gen types), never
# imported by application code. Not required to run the app.
SUPABASE_SERVICE_ROLE_KEY=
# Only used by supabase gen types / CLI, not the app itself.
SUPABASE_PROJECT_ID=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form rate limiting -- any random string, used to salt the IP hash
# stored on contact_messages so raw IPs are never persisted.
CONTACT_IP_HASH_SALT=change-me-to-a-random-string

# GitHub stats (Phase 3)
GITHUB_USERNAME=
GITHUB_TOKEN=
